# -----------------------------------------------------------------------------
# Local-development environment template.
# Copy to `.env` and fill in real values; `.env` is gitignored.
# -----------------------------------------------------------------------------

# --- Database backend selector -------------------------------------------------
DB_BACKEND=postgres

# --- Postgres / Cloud SQL ------------------------------------------------------
# Default flow: run the Cloud SQL Auth Proxy locally and connect over TCP.
#   cloud-sql-proxy --port 5432 vast-formula-478020-a1:us-central1:tfm-db
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=tlm_app
PG_PASSWORD=replace-me
PG_DATABASE=tlm

# --- Cloud SQL Unix-socket mode (alternative) ---------------------------------
# Set this and the proxy must mount a socket at /cloudsql/<value>; PG_HOST and
# PG_PORT are then ignored. Used by the Cloud Run runtime; not normally needed
# for local dev.
# INSTANCE_CONNECTION_NAME=vast-formula-478020-a1:us-central1:tfm-db
# DB_SOCKET_DIR=/cloudsql

# --- Qdrant (only when DB_BACKEND=qdrant) -------------------------------------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=
# QDRANT_GRPC=false
